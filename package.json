{
  "name": "__MSG_extensionName__",
  "displayName": "__MSG_extensionDisplayName__",
  "version": "1.9.0",
  "description": "__MSG_extensionDescription__",
  "author": "Ziitaa (forked from leaperone/MultiPost-Extension)",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build && plasmo package",
    "package": "plasmo package",
    "lint": "biome check",
    "lint:fix": "biome check --fix",
    "format": "biome format --write",
    "lint:staged": "lint-staged",
    "prepare": "husky"
  },
  "dependencies": {
    "@heroui/react": "2.7.8",
    "@heroui/theme": "2.4.6",
    "@mozilla/readability": "^0.6.0",
    "@plasmohq/storage": "^1.11.0",
    "lucide-react": "^0.447.0",
    "plasmo": "0.90.5",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-viewer": "^3.2.2",
    "tailwindcss": "3.3.5",
    "turndown": "^7.2.0",
    "uuid": "^10.0.0",
    "video-react": "^0.16.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "@iconify/react": "^5.2.0",
    "@types/chrome": "0.0.251",
    "@types/node": "20.9.0",
    "@types/react": "18.2.37",
    "@types/react-dom": "18.2.15",
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10",
    "postcss": "8.4.31",
    "typescript": "5.2.2"
  },
  "manifest": {
    "default_locale": "zh_CN",
    "externally_connectable": {
      "matches": [
        "https://paiban.md/*",
        "http://localhost:2663/*",
        "http://127.0.0.1:2663/*"
      ]
    },
    "host_permissions": [
      "https://*/*",
      "http://127.0.0.1:2663/*",
      "http://localhost:2663/*"
    ],
    "permissions": [
      "activeTab",
      "tabs",
      "scripting",
      "tabGroups",
      "clipboardWrite",
      "clipboardRead"
    ],
    "web_accessible_resources": [
      {
        "resources": [
          "assets/icon.png"
        ],
        "matches": [
          "https://www.plasmo.com/*"
        ]
      }
    ],
    "key": ""
  },
  "lint-staged": {
    "*.{js,ts,cjs,mjs,d.cts,d.mts,jsx,tsx,json,jsonc}": [
      "biome check --write --unsafe --no-errors-on-unmatched"
    ]
  }
}
